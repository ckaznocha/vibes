{
  "name": "alamo-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/alamo-mcp/src",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.spec.json",
        "{projectRoot}/tsconfig.app.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": [],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/alamo-mcp",
        "command": "tsc -p tsconfig.spec.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": []
        }
      ],
      "outputs": [],
      "options": {
        "command": "node --test",
        "cwd": "apps/alamo-mcp"
      }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "apps/alamo-mcp/dist",
        "format": ["esm"],
        "bundle": true,
        "main": "apps/alamo-mcp/src/main.ts",
        "tsConfig": "apps/alamo-mcp/tsconfig.app.json",
        "esbuildOptions": {
          "sourcemap": true,
          "banner": {
            "js": "#!/usr/bin/env node"
          }
        },
        "target": "node24",
        "excludeFromExternal": [
          "@ckaznocha/mcp-tool-result",
          "@ckaznocha/resilient-fetch"
        ]
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "banner": {
              "js": "#!/usr/bin/env node"
            }
          }
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "alamo-mcp:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "alamo-mcp:build:development"
        },
        "production": {
          "buildTarget": "alamo-mcp:build:production"
        }
      }
    }
  },
  "tags": [
    "scope:alamo-mcp",
    "type:app",
    "type:mcp-server",
    "publish:npm",
    "data-source:scraping",
    "safety:link-only"
  ]
}
