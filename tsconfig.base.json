{
  "extends": [
    "@tsconfig/node24/tsconfig.json",
    "@tsconfig/strictest/tsconfig.json"
  ],
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false,

    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "noUncheckedSideEffectImports": true
  }
}
